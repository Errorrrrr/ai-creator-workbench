{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Creator Workbench",
  "version": "0.8.0",
  "identifier": "com.aicreator.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI 创作工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost workbench-media: http://workbench-media.localhost data: blob:; media-src 'self' workbench-media: http://workbench-media.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0MTM4MTBEMDFGREU2NjUKUldSbDV2MEJEWUVUaFB2OUJYZDkranBjN0FKRU1xNDlWRk4ramVVNUlJQlVacS9rVnUwWDQ1czYK",
      "endpoints": [
        "https://github.com/Errorrrrr/ai-creator-workbench/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
